# Copy this file to `.env.local` and fill in the real values from your
# Supabase project dashboard (Project Settings -> API).
# `.env.local` is gitignored — never commit real credentials.

# Public URL of your Supabase project. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=

# Public "anon" API key. Safe to expose to the browser — access is governed
# by the Row Level Security policies defined in supabase/schema.sql.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret "service_role" key. Bypasses Row Level Security entirely — NEVER
# expose this to the browser or prefix it with NEXT_PUBLIC_. Only use it
# from trusted server-side code (e.g. Route Handlers) such as the chatbot
# logging endpoint described in supabase/schema.sql.
SUPABASE_SERVICE_ROLE_KEY=
